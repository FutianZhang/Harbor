{
  "contract_schema_version": 1,
  "timestamp_format": "RFC 3339 UTC with a trailing Z; preserve and use sub-second precision",
  "files": {
    "config.json": {
      "format": "JSON object",
      "required_fields": [
        "benchmark_id",
        "benchmark_t0_utc",
        "benchmark_t1_utc",
        "dataset_version",
        "generation_spec_sha256",
        "random_seed",
        "reporting_currency",
        "source_snapshot_sha256",
        "source_version",
        "year_fraction_convention"
      ],
      "additional_fields_allowed": false,
      "semantics": {
        "benchmark_id": "string; benchmark identity",
        "benchmark_t0_utc": "UTC timestamp; authoritative t0 valuation clock",
        "benchmark_t1_utc": "UTC timestamp; authoritative t1 valuation clock",
        "dataset_version": "string; frozen dataset identity",
        "generation_spec_sha256": "64-character lowercase hexadecimal provenance identifier; do not interpret as a financial input",
        "random_seed": "integer; reproducibility metadata",
        "reporting_currency": "string; must be USD",
        "source_snapshot_sha256": "64-character lowercase hexadecimal provenance identifier; do not interpret as a financial input",
        "source_version": "string; frozen source identity",
        "year_fraction_convention": "string; must be ACT/365"
      }
    },
    "initial_positions.csv": {
      "format": "UTF-8 CSV with header",
      "additional_columns_allowed": false,
      "row_granularity": "one row per instrument_name",
      "primary_key": ["instrument_name"],
      "canonical_sort_key": ["instrument_name ascending"],
      "duplicate_policy": "duplicate instrument_name is non-recoverable",
      "columns": [
        {
          "name": "instrument_name",
          "type": "string",
          "unit": null,
          "required": true,
          "description": "instrument identifier and foreign key to instrument_metadata.csv"
        },
        {
          "name": "quantity",
          "type": "finite float64",
          "unit": "contracts",
          "required": true,
          "description": "q0; positive is long and negative is short"
        }
      ]
    },
    "trades.csv": {
      "format": "UTF-8 CSV with header",
      "additional_columns_allowed": false,
      "row_granularity": "one row per trade",
      "primary_key": ["trade_id"],
      "canonical_sort_key": ["timestamp UTC ascending", "trade_id ascending"],
      "duplicate_policy": "duplicate trade_id is non-recoverable",
      "columns": [
        {
          "name": "trade_id",
          "type": "string",
          "unit": null,
          "required": true,
          "description": "unique trade identifier"
        },
        {
          "name": "timestamp",
          "type": "UTC timestamp string",
          "unit": "UTC",
          "required": true,
          "description": "trade timestamp; must be strictly after t0 and strictly before t1"
        },
        {
          "name": "instrument_name",
          "type": "string",
          "unit": null,
          "required": true,
          "description": "instrument foreign key"
        },
        {
          "name": "side",
          "type": "enum BUY|SELL",
          "unit": null,
          "required": true,
          "description": "BUY gives positive signed quantity; SELL gives negative signed quantity"
        },
        {
          "name": "quantity",
          "type": "finite float64 > 0",
          "unit": "contracts",
          "required": true,
          "description": "unsigned trade quantity"
        },
        {
          "name": "execution_price_usd",
          "type": "finite float64 >= 0",
          "unit": "USD per unit of underlying",
          "required": true,
          "description": "execution premium used in trade cashflow"
        },
        {
          "name": "fee_usd",
          "type": "finite float64 >= 0",
          "unit": "USD per trade",
          "required": true,
          "description": "already quantity-scaled total trade cost; subtract exactly once and do not multiply again"
        }
      ]
    },
    "instrument_metadata.csv": {
      "format": "UTF-8 CSV with header",
      "additional_columns_allowed": false,
      "row_granularity": "one row per instrument_name",
      "primary_key": ["instrument_name"],
      "canonical_sort_key": ["instrument_name ascending"],
      "duplicate_policy": "duplicate instrument_name is non-recoverable",
      "authoritative_for": [
        "underlying",
        "option_type",
        "strike_usd",
        "expiration_timestamp",
        "contract_multiplier"
      ],
      "columns": [
        {
          "name": "instrument_name",
          "type": "string",
          "unit": null,
          "required": true,
          "description": "unique instrument identifier"
        },
        {
          "name": "underlying",
          "type": "enum BTC|ETH",
          "unit": null,
          "required": true,
          "description": "underlying asset"
        },
        {
          "name": "option_type",
          "type": "enum call|put",
          "unit": null,
          "required": true,
          "description": "European option type"
        },
        {
          "name": "strike_usd",
          "type": "finite float64 > 0",
          "unit": "USD per unit of underlying",
          "required": true,
          "description": "K"
        },
        {
          "name": "expiration_timestamp",
          "type": "UTC timestamp string",
          "unit": "UTC",
          "required": true,
          "description": "option expiry"
        },
        {
          "name": "contract_multiplier",
          "type": "finite float64 > 0",
          "unit": "units of underlying per contract",
          "required": true,
          "description": "m; authoritative quantity scaler, applied exactly once"
        },
        {
          "name": "price_index",
          "type": "string",
          "unit": null,
          "required": false,
          "description": "descriptive source index; not a pricing input"
        },
        {
          "name": "maturity_bucket",
          "type": "string",
          "unit": null,
          "required": false,
          "description": "descriptive maturity label; exact timestamps remain authoritative"
        }
      ]
    },
    "rates.csv": {
      "format": "UTF-8 CSV with header",
      "additional_columns_allowed": false,
      "row_granularity": "one row per instrument_name",
      "primary_key": ["instrument_name"],
      "canonical_sort_key": ["instrument_name ascending"],
      "duplicate_policy": "duplicate instrument_name is non-recoverable",
      "columns": [
        {
          "name": "instrument_name",
          "type": "string",
          "unit": null,
          "required": true,
          "description": "instrument foreign key"
        },
        {
          "name": "rate_decimal",
          "type": "finite float64",
          "unit": "decimal continuously compounded annual rate",
          "required": true,
          "description": "authoritative r for both t0 and t1"
        },
        {
          "name": "benchmark_t0_utc",
          "type": "UTC timestamp string",
          "unit": "UTC",
          "required": true,
          "description": "must exactly equal config.json benchmark_t0_utc"
        },
        {
          "name": "benchmark_t1_utc",
          "type": "UTC timestamp string",
          "unit": "UTC",
          "required": true,
          "description": "must exactly equal config.json benchmark_t1_utc"
        }
      ]
    },
    "market_t0.parquet": {
      "format": "Apache Parquet",
      "additional_columns_allowed": false,
      "row_granularity": "one core state per instrument after exact-row deduplication",
      "primary_key_after_normalization": ["instrument_name"],
      "canonical_sort_key": ["instrument_name ascending"],
      "duplicate_policy": "an exact duplicate across every present column is recoverable and deduplicated; any same-instrument duplicate that differs in any core or optional column is non-recoverable",
      "optional_numeric_value_policy": {
        "precondition": "the Parquet container is readable and the declared optional column physical type exactly matches this input_schema",
        "physical_type_mismatch": "SCHEMA_ERROR",
        "undeclared_column": "SCHEMA_ERROR",
        "unreadable_container": "SCHEMA_ERROR",
        "required_or_core_type_mismatch": "SCHEMA_ERROR",
        "value_level_warning_code": "OPTIONAL_QUOTE_IGNORED",
        "non_finite_values": ["NaN", "+Infinity", "-Infinity"],
        "semantic_invalid_values": {
          "source_bid_price_coin": "value < 0; value == 0 uses OPTIONAL_QUOTE_ZERO_BID",
          "source_ask_price_coin": "value <= 0",
          "source_mark_price_coin": "value <= 0",
          "source_mark_iv_pct": "value <= 0",
          "source_orderbook_timestamp_ms": "value < 0"
        },
        "null_value": "OPTIONAL_QUOTE_MISSING for optional quote fields; an absent optional provenance value is ignored without becoming OPTIONAL_QUOTE_IGNORED"
      },
      "columns": [
        {"name": "instrument_name", "type": "string", "unit": null, "required": true, "description": "instrument foreign key"},
        {"name": "underlying", "type": "string", "unit": null, "required": true, "description": "must match authoritative metadata"},
        {"name": "option_type", "type": "string", "unit": null, "required": true, "description": "must match authoritative metadata"},
        {"name": "valuation_timestamp", "type": "UTC timestamp string", "unit": "UTC", "required": true, "description": "must equal config t0"},
        {"name": "spot_usd", "type": "finite float64 > 0", "unit": "USD per unit of underlying", "required": true, "description": "S0"},
        {"name": "strike_usd", "type": "finite float64 > 0", "unit": "USD per unit of underlying", "required": true, "description": "must match authoritative metadata"},
        {"name": "expiration_timestamp", "type": "UTC timestamp string", "unit": "UTC", "required": true, "description": "must match authoritative metadata"},
        {"name": "iv_decimal", "type": "finite float64 > 0 before expiry", "unit": "decimal volatility", "required": true, "description": "sigma0; 0.50 means 50 percent IV"},
        {"name": "rate_decimal", "type": "finite float64", "unit": "decimal continuously compounded annual rate", "required": true, "description": "redundant copy that must equal rates.csv"},
        {"name": "contract_multiplier", "type": "finite float64 > 0", "unit": "units of underlying per contract", "required": true, "description": "redundant copy that must equal authoritative metadata"},
        {"name": "source_bid_price_coin", "type": "nullable float64", "physical_type": "double", "unit": "source observation units", "required": false, "description": "optional observation only; never a theoretical valuation input"},
        {"name": "source_ask_price_coin", "type": "nullable float64", "physical_type": "double", "unit": "source observation units", "required": false, "description": "optional observation only; never a theoretical valuation input"},
        {"name": "source_mark_price_coin", "type": "nullable float64", "physical_type": "double", "unit": "source observation units", "required": false, "description": "optional observation only; never a theoretical valuation input"},
        {"name": "source_mark_iv_pct", "type": "nullable float64", "physical_type": "double", "unit": "source percentage points", "required": false, "description": "optional observation only; iv_decimal is authoritative"},
        {"name": "source_orderbook_timestamp_ms", "type": "nullable int64", "physical_type": "int64", "unit": "Unix milliseconds", "required": false, "description": "optional provenance observation; never a valuation clock"}
      ]
    },
    "market_t1.parquet": {
      "format": "Apache Parquet",
      "additional_columns_allowed": false,
      "row_granularity": "one row per instrument_name",
      "primary_key": ["instrument_name"],
      "canonical_sort_key": ["instrument_name ascending"],
      "duplicate_policy": "duplicate instrument_name is non-recoverable",
      "columns": [
        {"name": "instrument_name", "type": "string", "unit": null, "required": true, "description": "instrument foreign key"},
        {"name": "underlying", "type": "string", "unit": null, "required": true, "description": "must match authoritative metadata"},
        {"name": "option_type", "type": "string", "unit": null, "required": true, "description": "must match authoritative metadata"},
        {"name": "valuation_timestamp", "type": "UTC timestamp string", "unit": "UTC", "required": true, "description": "must equal config t1"},
        {"name": "spot_usd", "type": "finite float64 > 0", "unit": "USD per unit of underlying", "required": true, "description": "S1"},
        {"name": "strike_usd", "type": "finite float64 > 0", "unit": "USD per unit of underlying", "required": true, "description": "must match authoritative metadata"},
        {"name": "expiration_timestamp", "type": "UTC timestamp string", "unit": "UTC", "required": true, "description": "must match authoritative metadata"},
        {"name": "iv_decimal", "type": "finite float64 > 0 before expiry", "unit": "decimal volatility", "required": true, "description": "sigma1"},
        {"name": "rate_decimal", "type": "finite float64", "unit": "decimal continuously compounded annual rate", "required": true, "description": "redundant copy that must equal rates.csv"},
        {"name": "contract_multiplier", "type": "finite float64 > 0", "unit": "units of underlying per contract", "required": true, "description": "redundant copy that must equal authoritative metadata"},
        {"name": "spot_shock_pct", "type": "nullable float64", "unit": "decimal percentage move", "required": false, "description": "audit-only observed t0-to-t1 move; derive dS from spot_usd values"},
        {"name": "iv_change_decimal", "type": "nullable float64", "unit": "absolute decimal volatility change", "required": false, "description": "audit-only observed t0-to-t1 change; derive dSigma from iv_decimal values"}
      ]
    },
    "scenarios.json": {
      "format": "JSON object",
      "required_fields": ["scenarios"],
      "additional_fields_allowed": false,
      "scenario_required_fields": ["scenario_id", "spot_shock_pct", "vol_shock_abs"],
      "scenario_additional_fields_allowed": false,
      "row_granularity": "one object per scenario",
      "primary_key": ["scenario_id"],
      "canonical_sort_key": ["scenario_id ascending"],
      "semantics": {
        "scenario_id": "non-empty unique string",
        "spot_shock_pct": "finite decimal percentage shock; 0.10 means plus 10 percent",
        "vol_shock_abs": "finite absolute decimal volatility shock; 0.20 means plus 20 volatility points"
      }
    }
  },
  "relationships": [
    "Every instrument_metadata.csv instrument must exist exactly once in rates.csv, normalized market_t0, and market_t1; positions and trades may reference only metadata instruments.",
    "initial_positions.csv may omit zero positions; a metadata instrument absent from initial_positions.csv has q0 equal to zero.",
    "Metadata is authoritative for underlying, option_type, strike_usd, expiration_timestamp, and contract_multiplier; redundant market values must match exactly.",
    "rates.csv is authoritative for rate_decimal; redundant t0 and t1 rate values must match exactly.",
    "Valuation timestamps and rate clock fields must exactly match config.json.",
    "Input row order is never financial information; process using the stated keys and produce deterministic warnings when normalization is needed."
  ]
}
